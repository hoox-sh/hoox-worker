{
  "name": "hoox",
  // ACCOUNT_ID: Get from Cloudflare Dashboard > Overview > Account ID
  "account_id": "YOUR_ACCOUNT_ID",
  "main": "src/index.ts",
    "alias": {
    "@hoox-sh/hoox-shared/errors": "../../packages/shared/src/errors.ts",
    "@hoox-sh/hoox-shared/middleware": "../../packages/shared/src/middleware/index.ts",
    "@hoox-sh/hoox-shared/router": "../../packages/shared/src/router.ts",
    "@hoox-sh/hoox-shared/types": "../../packages/shared/src/types.ts",
    "@hoox-sh/hoox-shared/types/router": "../../packages/shared/src/types/router.ts",
    "@hoox-sh/hoox-shared/analytics": "../../packages/shared/src/analytics.ts",
    "@hoox-sh/hoox-shared/kvKeys": "../../packages/shared/src/kvKeys.ts",
    "@hoox-sh/hoox-shared/legal": "../../packages/shared/src/legal.ts",
    "@hoox-sh/hoox-shared/service-bindings": "../../packages/shared/src/service-bindings.ts"
  },
  // COMPATIBILITY_DATE: monorepo standard (align with sibling workers)
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],

  // PLACEMENT: Smart Placement for reduced latency (free, all plans)
  "placement": {
    "mode": "smart",
  },

  // OBSERVABILITY: logs + unified traces (CF May 2026)
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  // VARS: Environment variables (secrets set via `wrangler secret put`)
  // Replace null with actual values in .dev.vars for local dev
  "vars": {
    // WEBHOOK_API_KEY: Your webhook authentication key
    // Set via: wrangler secret put WEBHOOK_API_KEY_BINDING
    "WEBHOOK_API_KEY_BINDING": null,
    // INTERNAL_KEY: Service-to-service authentication
    // Set via: wrangler secret put INTERNAL_KEY_BINDING
    "INTERNAL_KEY_BINDING": null,
    // OPERATOR_API_KEY: Bearer secret for management plane (/v1/*)
    // Client: HOOX_API_TOKEN must match this value
    // Set via: wrangler secret put OPERATOR_API_KEY
    // "OPERATOR_API_KEY": null,
    // HA_TOKEN: Home Assistant access token (optional)
    // Set via: wrangler secret put HA_TOKEN_BINDING
    "HA_TOKEN_BINDING": null,
    // TELEGRAM_ALLOWED_CHAT_IDS: comma-separated chat IDs allowed for webhook
    // notify payloads. Fail-closed: notify is rejected when unset.
    // Also readable from CONFIG_KV key `telegram:allowed_chat_ids` (JSON array).
    // Alias: AUTHORIZED_CHAT_IDS (same shape as telegram-worker).
    // Set via: wrangler secret put TELEGRAM_ALLOWED_CHAT_IDS
    // "TELEGRAM_ALLOWED_CHAT_IDS": "123456789,-1001234567890",
  },

  // SERVICES: Service bindings to other workers
  // TRADE_SERVICE: Points to trade-worker for executing trades
  // TELEGRAM_SERVICE: Points to telegram-worker for notifications
  // ANALYTICS_SERVICE: Points to analytics-worker for event tracking
  "services": [
    {
      "binding": "ANALYTICS_SERVICE",
      "service": "analytics-worker",
    },
    {
      "binding": "TRADE_SERVICE",
      "service": "trade-worker",
    },
    {
      "binding": "TELEGRAM_SERVICE",
      "service": "telegram-worker",
    },
  ],

  // KV_NAMESPACES: Key-Value storage for config, sessions, and rate limiting
  // CONFIG_KV is also used by the KV-backed rate limiter for persistence across cold starts
  // Get IDs from Cloudflare Dashboard > KV > Namespaces
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      // ID: KV namespace for session storage
      "id": "YOUR_SESSIONS_KV_ID",
    },
    {
      "binding": "CONFIG_KV",
      // ID: KV namespace for dynamic configuration and rate limiting
      "id": "YOUR_CONFIG_KV_ID",
    },
  ],

  // VECTORIZE: AI embeddings index for RAG
  // Get index_name from Cloudflare Dashboard > Vectorize
  "vectorize": [
    {
      "binding": "VECTORIZE_INDEX",
      // INDEX_NAME: Your Vectorize index name
      "index_name": "YOUR_INDEX_NAME",
    },
  ],

  // AI: Cloudflare Workers AI for running AI models
  "ai": {
    "binding": "AI",
  },

  // QUEUES: Queue producer for trade execution
  // QUEUE_NAME: Get from Cloudflare Dashboard > Queues
  "queues": {
    "producers": [
      {
        // QUEUE: Queue name for trade execution
        "queue": "YOUR_TRADE_QUEUE_NAME",
        "binding": "TRADE_QUEUE"
      }
    ]
  },

  // DURABLE_OBJECTS: idempotency + atomic trade rate limiting
  "durable_objects": {
    "bindings": [
      {
        // NAME: Binding name in worker code
        "name": "IDEMPOTENCY_STORE",
        // CLASS_NAME: Durable Object class (must match DO class name)
        "class_name": "IdempotencyStore"
      },
      {
        // Atomic multi-isolate rate limits (trade path MAX_TRADES_PER_MINUTE)
        // Without this binding, gateway falls back to CONFIG_KV / in-memory
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterStore"
      }
    ]
  },

  // MIGRATIONS: SQLite-backed Durable Object registration
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IdempotencyStore"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "RateLimiterStore"
      ]
    }
  ]
}